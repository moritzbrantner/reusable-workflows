{
  "name": "@moritzbrantner/reusable-workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006",
    "storybook:build": "storybook build --quiet -o storybook-static",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --format=github",
    "check-types": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "test:a11y": "bun run build && playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "test:a11y:dist": "playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "test:visual": "bun run build && playwright test tests/e2e/visual.spec.ts --project=chromium",
    "test:visual:dist": "playwright test tests/e2e/visual.spec.ts --project=chromium",
    "test:integration": "bun run validate:contracts && bun run size:check",
    "test:storybook": "bun scripts/check-storybook-static.ts",
    "test:unlighthouse": "bun run build && bun scripts/run-unlighthouse.mjs",
    "bench": "bun scripts/run-benchmarks.ts",
    "size:check": "bun run build && bun run size:check:dist",
    "size:check:dist": "bun scripts/check-bundle-size.ts",
    "api:check": "bun run validate:contracts",
    "validate:contracts": "bun scripts/validate-workflow-contracts.ts",
    "verify": "bun run format:check && bun run lint && bun run check-types && bun run test:unit && bun run build && bun run validate:contracts && bun run size:check:dist && bun run storybook:build && bun run test:storybook && bun run bench"
  },
  "dependencies": {
    "@moritzbrantner/ui": "^0.10.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/addon-docs": "10.4.1",
    "@storybook/react-vite": "10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "0.52.0",
    "oxlint": "^1.61.0",
    "storybook": "10.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "unlighthouse": "^0.17.9",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "yaml": "^2.8.2"
  }
}
