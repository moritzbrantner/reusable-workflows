{
  "schemaVersion": 1,
  "globalInputs": ["package.json", "bun.lock", "tsconfig.json"],
  "ignoredInputs": ["docs/**", "**/*.md"],
  "units": {
    "format-lint-types": {
      "inputs": ["src/**", "scripts/**", ".oxlintrc.json", ".oxfmtrc.json"]
    },
    "unit": {
      "inputs": ["src/**"],
      "dependsOn": ["format-lint-types"]
    },
    "contracts": {
      "inputs": [
        ".github/workflows/**",
        "contracts/**",
        "scripts/generate-workflow-manifest.ts",
        "scripts/validate-workflow-contracts.ts"
      ]
    },
    "e2e": {
      "inputs": ["tests/e2e/**", "playwright.config.ts"],
      "dependsOn": ["unit"]
    }
  }
}
