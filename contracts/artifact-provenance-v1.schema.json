{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reusable Workflows Artifact Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "artifact", "qualification"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sha"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowRef", "runId", "runAttempt"],
      "properties": {
        "workflowRef": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
