{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "typecheck", "build", "test:unit"],
    "full": [
      "format:check",
      "lint",
      "typecheck",
      "build",
      "test:unit",
      "test:integration",
      "test:e2e",
      "test:accessibility",
      "test:visual",
      "storybook:check",
      "web:audit",
      "benchmark"
    ]
  },
  "requiredCapabilities": ["format:check", "lint", "typecheck", "build", "test:unit"],
  "optionalCapabilities": [
    "test:integration",
    "test:e2e",
    "test:accessibility",
    "test:visual",
    "storybook:check",
    "web:audit",
    "benchmark"
  ],
  "capabilityCommands": {
    ".": {
      "format:check": ["bun", "run", "format:check"],
      "lint": ["bun", "run", "lint"],
      "typecheck": ["bun", "run", "check-types"],
      "build": ["bun", "run", "build"],
      "test:unit": ["bun", "run", "test:unit"],
      "test:integration": ["bun", "run", "test:integration"],
      "test:e2e": ["bun", "run", "test:e2e"],
      "test:accessibility": ["bun", "run", "test:a11y"],
      "test:visual": ["bun", "run", "test:visual"],
      "storybook:check": ["bash", "-lc", "bun run storybook:build && bun run test:storybook"],
      "web:audit": ["bun", "run", "test:unlighthouse"],
      "benchmark": ["bun", "run", "bench"]
    }
  },
  "conventionRefs": ["AGENT-001", "AGENT-007"],
  "merge": {
    "authority": "hosted",
    "requiredChecks": [
      "app-validation / Fast Validation",
      "coding-tooling-fast / Coding Tooling Validation",
      "actionlint"
    ]
  }
}
