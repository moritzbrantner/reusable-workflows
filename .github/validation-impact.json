{
  "schemaVersion": 1,
  "globalInputs": [],
  "ignoredInputs": ["docs/**", "**/*.md"],
  "units": {
    "semantic": {
      "inputs": [
        ".coding-tooling.json",
        ".repository-environment.toml",
        ".github/**",
        ".conventions/**",
        "contracts/**",
        "package.json",
        "bun.lock",
        "tsconfig.json",
        "vite.config.ts",
        "playwright.config.ts",
        "index.html",
        "public/**",
        "src/**",
        "scripts/**",
        "tests/**",
        "README.md",
        "CONTEXT.md",
        "*.config.*",
        "*.ts",
        "*.tsx",
        "*.js",
        "*.mjs",
        "*.cjs"
      ]
    },
    "web-build": {
      "inputs": [
      ".github/workflows/**",
      ".repository-environment.toml",
      "bun.lock",
      "contracts/workflows.json",
      "index.html",
      "package.json",
      "public/**",
      "scripts/check-bundle-size.ts",
      "scripts/codex-environment.sh",
      "scripts/generate-agent-pages.ts",
      "scripts/generate-workflow-manifest.ts",
      "scripts/workflow-catalog-data.ts",
      "scripts/workflow-catalog-plugin.ts",
      "src/**",
      "tsconfig.json",
      "vite.config.ts"
]
    },
    "actionlint": {
      "inputs": [".github/workflows/**"]
    }
  }
}
